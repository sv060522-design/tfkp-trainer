{
  "name": "tfkp-trainer",
  "private": true,
  "scripts": {
    "build:portable": "node scripts/build-portable.cjs",
    "start": "node server/index.cjs",
    "test:portable": "npm run build:portable && node scripts/check-portable.cjs",
    "test": "node scripts/check-catalog.js && node scripts/check-mathjax.js",
    "test:theory": "python3 scripts/check-theory.py && node scripts/check-theory-state.cjs",
    "test:account": "node scripts/check-account.cjs && node scripts/check-sync.cjs",
    "test:all": "npm test && npm run test:theory && npm run test:account && npm run test:portable"
  },
  "devDependencies": {
    "fengari": "0.1.5",
    "jsdom": "30.1.2",
    "mathjax": "3.2.2",
    "mathjax-full": "3.2.2"
  },
  "dependencies": {
    "express": "5.3.0"
  }
}
