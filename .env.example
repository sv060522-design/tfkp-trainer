# Set these privately in the hosting control panel, using the SAME datastore.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# HTTPS origin assigned by the new host; no path or query string.
PUBLIC_ORIGIN=
PORT=8080
# Timeweb HTTPS ingress: verify the number of trusted proxies on deployment.
TRUST_PROXY_HOPS=1
# Keep false until the new host passes checks and becomes the primary address.
INDEX_SITE=false
